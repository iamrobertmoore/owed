# Environment names only. Values live in the Convex deployment, never here.

# Set by `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Convex Auth signing keys, generated by `npx @convex-dev/auth`
JWT_PRIVATE_KEY=
JWKS=

# Firecrawl. 20k credits come with hackathon registration.
FIRECRAWL_API_KEY=

# AgentMail. Free tier is enough: 3 inboxes, 100 emails/day.
# Set with: npx convex env set AGENTMAIL_API_KEY <key>
AGENTMAIL_API_KEY=
# Shared secret AgentMail signs its webhook deliveries with.
AGENTMAIL_WEBHOOK_SECRET=
# Optional. Only set this for EU data residency.
# AGENTMAIL_BASE_URL=https://api.agentmail.eu/v0

# OpenAI. No credits are provided by the event, so every call is cached and
# logged in the aiCache table and the spend stays visible.
OPENAI_API_KEY=
