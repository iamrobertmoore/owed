{
  "name": "owed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your agent holds the paper trail, so it finds what you are owed instead of waiting to be told.",
  "scripts": {
    "dev": "concurrently -n convex,web -c magenta,cyan \"convex dev\" \"vite\"",
    "dev:web": "vite",
    "dev:convex": "convex dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx @convex-dev/static-hosting deploy",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@agentmail/convex": "^0.1.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/static-hosting": "^0.2.1",
    "@firecrawl/firecrawl-convex": "^0.1.1",
    "convex": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
